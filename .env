# Local SQLite mode — no Cloudflare needed
MCP_MEMORY_STORAGE_BACKEND=sqlite_vec
MCP_INIT_TIMEOUT=5
MCP_ALLOW_ANONYMOUS_ACCESS=true

# Critical: WAL mode prevents "database is locked" when MCP + HTTP run together
MCP_MEMORY_SQLITE_PRAGMAS=journal_mode=WAL,busy_timeout=15000,cache_size=20000

# Hybrid search (BM25 + vector)
MCP_HYBRID_SEARCH_ENABLED=true

# Consolidation (off by default, enable later)
MCP_CONSOLIDATION_ENABLED=true
MCP_SCHEDULE_DAILY=disabled
MCP_SCHEDULE_WEEKLY=disabled
MCP_SCHEDULE_MONTHLY=disabled
